---
import SignUpForm from '@/components/auth/signUpForm'
import Layout from '@/layouts/Layout.astro'
import { name } from '@/data/info.json'

const title: string = `Registro - ${name}`
---

<Layout title={title}>
  <div
    id="register-main-container"
    class="flex w-full flex-1 items-center justify-center bg-cyan-400 px-4 py-12 font-mono text-black"
  >
    <SignUpForm client:only="react" />
  </div>
</Layout>
