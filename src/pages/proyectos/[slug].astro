---
import { getEntry, render } from 'astro:content'
import Layout from '@/layouts/Layout.astro'

const { slug } = Astro.params

if (!slug) {
  throw new Error('No se ha proporcionado url valida')
}

const project = await getEntry('projects', `projects/${slug}`)

if (!project) {
  throw new Error('Project not found')
}

const { Content } = await render(project)
---

<Layout title={`${project.data.title} - Proyectos`}>
  <div
    class="w-full bg-cyan-400 px-4 py-12 font-mono text-black sm:px-6 lg:px-8"
  >
    <article
      class="mx-auto max-w-4xl border-4 border-black bg-white p-6 shadow-[10px_10px_0px_0px_rgba(0,0,0,1)] md:p-10"
    >
      <a
        href="/proyectos"
        class="mb-6 inline-block border-2 border-black bg-yellow-300 px-3 py-1 text-xs font-black uppercase shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:bg-pink-400"
      >
        ← Volver a Proyectos
      </a>

      <header class="mb-8 border-b-4 border-black pb-6">
        <div class="mb-3 flex items-center gap-2">
          <span
            class={`border-2 border-black ${project.data.badgeColor} px-2 py-0.5 text-xs font-black uppercase shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]`}
          >
            {project.data.status}
          </span>
          <time class="text-xs font-bold">
            {
              project.data.pubDate.toLocaleDateString('es-ES', {
                dateStyle: 'long',
              })
            }
          </time>
        </div>

        <h1 class="text-3xl font-black uppercase sm:text-5xl">
          {project.data.title}
        </h1>
        <p class="mt-3 text-sm font-bold text-slate-700">
          {project.data.description}
        </p>

        <div class="mt-6 flex flex-wrap gap-3">
          {
            project.data.github && (
              <a
                href={project.data.github}
                target="_blank"
                rel="noopener noreferrer"
                class="border-2 border-black bg-black px-4 py-1.5 text-xs font-black text-white uppercase shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:bg-slate-800"
              >
                GitHub Repo ↗
              </a>
            )
          }
          {
            project.data.demo && (
              <a
                href={project.data.demo}
                target="_blank"
                rel="noopener noreferrer"
                class="border-2 border-black bg-lime-300 px-4 py-1.5 text-xs font-black text-black uppercase shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:bg-lime-400"
              >
                Demo Live ↗
              </a>
            )
          }
        </div>
      </header>

      <div
        class="prose prose-slate prose-headings:font-black prose-headings:uppercase prose-h1:border-b-2 prose-h1:border-black prose-code:border prose-code:border-black prose-code:bg-yellow-200 prose-code:px-1 prose-img:border-4 prose-img:border-black prose-img:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] max-w-none font-mono font-medium"
      >
        <Content />
      </div>
    </article>
  </div>
</Layout>
