---
import { getCollection } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import { name } from '@/data/info.json'

const title = `Proyectos - ${name}`

const projects = await getCollection('projects')

// Ordenar por fecha de publicación (más recientes primero)
projects.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
---

<Layout title={title}>
  <div class="w-full bg-cyan-400 font-mono text-black px-4 py-12 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      
      <header class="mb-12">
        <div class="inline-block border-4 border-black bg-yellow-300 p-4 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]">
          <h1 class="text-4xl font-black uppercase tracking-tight sm:text-6xl">
            CATÁLOGO DE PROYECTOS
          </h1>
        </div>
        <p class="mt-4 max-w-2xl border-l-4 border-black bg-white p-3 font-bold text-sm shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
          Listado de sistemas hardware, software libre y prototipos IOTUS documentados en Markdown/MDX.
        </p>
      </header>

      <section class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {projects.map((project: any) => (
          <article class="flex flex-col justify-between border-4 border-black bg-white p-6 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] transition-transform hover:-translate-y-1">
            <div>
              <!-- Header Card -->
              <div class="mb-4 flex items-center justify-between border-b-2 border-black pb-2">
                <span class={`border-2 border-black ${project.data.badgeColor} px-2 py-0.5 text-xs font-black uppercase shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]`}>
                  {project.data.status}
                </span>
                <time class="text-xs font-bold" datetime={project.data.pubDate.toISOString()}>
                  {project.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'short' })}
                </time>
              </div>

              <!-- Título & Descripción -->
              <h2 class="mb-2 text-2xl font-black uppercase tracking-tight">
                <a href={`/proyectos/${project.id.split("/")[1]}`} class="hover:underline">
                  {project.data.title}
                </a>
              </h2>
              <p class="mb-4 text-xs font-bold leading-relaxed text-slate-800">
                {project.data.description}
              </p>
            </div>

            <!-- Tags y Enlace -->
            <div class="mt-4 border-t-2 border-black pt-4">
              <div class="mb-4 flex flex-wrap gap-1.5">
                {project.data.tags.map((tag: string) => (
                  <span class="border border-black bg-slate-100 px-1.5 py-0.5 text-[10px] font-black uppercase">
                    #{tag}
                  </span>
                ))}
              </div>

              <a
                href={`/proyectos/${project.id.split("/")[1]}`}
                class="block w-full border-2 border-black bg-yellow-300 py-2 text-center text-xs font-black uppercase shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] transition-all hover:bg-pink-400 active:translate-x-0.5 active:translate-y-0.5 active:shadow-none"
              >
                VER PROYECTO ➔
              </a>
            </div>
          </article>
        ))}
      </section>

    </div>
  </div>
</Layout>