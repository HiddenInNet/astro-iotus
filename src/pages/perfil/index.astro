---
import { name } from '@/data/info.json'
import Layout from '@/layouts/Layout.astro'
import { createSupabaseServerClient } from '@/lib/supabase'

const title = `Perfil personal - ${name}`

// 1. Obtener usuario expuesto por el middleware
const user = Astro.locals.user

if (!user) {
  return Astro.redirect('/login')
}

// 2. Consultar roles del usuario en Supabase
const supabase = createSupabaseServerClient(Astro)
const { data: userRoles } = await supabase
  .from('user_roles')
  .select('role_id')
  .eq('user_id', user.id)

const rolesList = userRoles?.map((r) => r.role_id) || ['USER']
const avatarUrl = user.user_metadata?.avatar_url
const fullName = user.user_metadata?.full_name || ''
const initial = user.email ? user.email.charAt(0).toUpperCase() : 'U'

// Estado de la URL para mensajes de feedback
const updated = Astro.url.searchParams.get('updated') === 'true'
const errorMessage = Astro.url.searchParams.get('error')
---

<Layout title={title}>
  <div
    class="min-h-screen w-full bg-cyan-400 px-4 py-12 font-mono text-black sm:px-6 lg:px-8"
  >
    <main
      class="mx-auto max-w-3xl border-4 border-black bg-white p-6 shadow-[10px_10px_0px_0px_rgba(0,0,0,1)] md:p-10"
    >
      <!-- Volver -->
      <a
        href="/"
        class="mb-6 inline-block border-2 border-black bg-yellow-300 px-3 py-1 text-xs font-black uppercase shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all hover:bg-pink-400 active:translate-x-0.5 active:translate-y-0.5 active:shadow-none"
      >
        ← Volver al Inicio
      </a>

      <!-- Alertas de Feedback -->
      {
        updated && (
          <div class="mb-6 border-3 border-black bg-lime-300 p-3 text-xs font-black uppercase shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
            ✅ ¡Perfil actualizado correctamente!
          </div>
        )
      }

      {
        errorMessage && (
          <div class="mb-6 border-3 border-black bg-red-400 p-3 text-xs font-black uppercase shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
            ⚠️ Error: {errorMessage}
          </div>
        )
      }

      <!-- Header del Perfil -->
      <header
        class="mb-8 flex flex-col items-center gap-6 border-b-4 border-black pb-8 sm:flex-row sm:items-start"
      >
        <!-- Avatar Neobrutalista -->
        <div class="relative">
          {
            avatarUrl ? (
              <img
                src={avatarUrl}
                alt="Avatar"
                class="h-24 w-24 border-4 border-black object-cover shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
              />
            ) : (
              <div class="flex h-24 w-24 items-center justify-center border-4 border-black bg-pink-400 text-4xl font-black text-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
                {initial}
              </div>
            )
          }
        </div>

        <div class="flex-1 text-center sm:text-left">
          <div
            class="mb-2 flex flex-wrap justify-center gap-2 sm:justify-start"
          >
            {
              rolesList.map((role) => (
                <span class="border-2 border-black bg-yellow-300 px-2.5 py-0.5 text-xs font-black uppercase shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
                  {role}
                </span>
              ))
            }
          </div>
          <h1 class="text-2xl font-black uppercase sm:text-4xl">
            {fullName || 'Usuario IOTUS'}
          </h1>
          <p class="mt-1 text-sm font-bold text-slate-700">{user.email}</p>
        </div>
      </header>

      <!-- Formulario de Edición de Perfil -->
      <section class="mb-8 space-y-4">
        <h2 class="border-b-2 border-black pb-1 text-lg font-black uppercase">
          Editar Perfil
        </h2>

        <form
          action="/api/auth/update-profile"
          method="POST"
          enctype="multipart/form-data"
          class="space-y-4"
        >
          <!-- Nombre de Perfil -->
          <div>
            <label
              for="fullName"
              class="mb-1 block text-xs font-black uppercase"
            >
              Nombre de Perfil
            </label>
            <input
              type="text"
              id="fullName"
              name="fullName"
              value={fullName}
              placeholder="Tu nombre completo"
              class="w-full border-3 border-black bg-slate-100 p-3 text-sm font-bold placeholder-slate-400 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] focus:bg-white focus:outline-none"
            />
          </div>

          <!-- Imagen de Avatar (Archivo) -->
          <div>
            <label
              for="avatarFile"
              class="mb-1 block text-xs font-black uppercase"
            >
              Foto de Perfil
            </label>
            <input
              type="file"
              id="avatarFile"
              name="avatarFile"
              accept="image/*"
              class="w-full border-3 border-black bg-slate-100 p-2 text-xs font-bold shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] file:mr-4 file:cursor-pointer file:border-2 file:border-black file:bg-yellow-300 file:px-3 file:py-1 file:text-xs file:font-black file:uppercase file:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:file:bg-pink-400 focus:bg-white focus:outline-none"
            />
          </div>

          <!-- Save Button -->
          <button
            type="submit"
            class="cursor-pointer border-3 border-black bg-lime-300 px-6 py-2.5 text-xs font-black uppercase shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] transition-all hover:bg-yellow-300 active:translate-x-0.5 active:translate-y-0.5 active:shadow-none"
          >
            GUARDAR CAMBIOS ➔
          </button>
        </form>
      </section>

      <!-- Detalles de la Cuenta -->
      <section class="space-y-6">
        <h2 class="border-b-2 border-black pb-1 text-lg font-black uppercase">
          Detalles de la Cuenta
        </h2>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <!-- ID de Usuario -->
          <div
            class="border-3 border-black bg-slate-100 p-4 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
          >
            <span class="block text-xs font-black text-slate-500 uppercase"
              >ID de Usuario</span
            >
            <span class="mt-1 block truncate font-mono text-xs font-bold"
              >{user.id}</span
            >
          </div>

          <!-- Fecha de Registro -->
          <div
            class="border-3 border-black bg-slate-100 p-4 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
          >
            <span class="block text-xs font-black text-slate-500 uppercase"
              >Miembro Desde</span
            >
            <span class="mt-1 block text-sm font-bold">
              {
                new Date(user.created_at).toLocaleDateString('es-ES', {
                  dateStyle: 'long',
                })
              }
            </span>
          </div>
        </div>

        <!-- Acceso Especial -->
        {
          (rolesList.includes('ADMIN') || rolesList.includes('MEMBER')) && (
            <div class="border-4 border-black bg-lime-300 p-4 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
              <h3 class="text-sm font-black uppercase">
                Acceso Especial Otorgado
              </h3>
              <p class="mt-1 text-xs font-bold">
                Tienes acceso al inventario del portal.
              </p>
              <a
                href="/inventario"
                class="mt-3 inline-block border-2 border-black bg-white px-3 py-1 text-xs font-black uppercase shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:bg-yellow-300"
              >
                Ir al Inventario ➔
              </a>
            </div>
          )
        }
      </section>

      <!-- Botón de Cerrar Sesión -->
      <footer class="mt-10 border-t-4 border-black pt-6">
        <form action="/api/auth/signout" method="POST">
          <button
            type="submit"
            class="w-full cursor-pointer border-4 border-black bg-red-400 py-3 text-sm font-black text-black uppercase shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all hover:bg-red-500 active:translate-x-1 active:translate-y-1 active:shadow-none"
          >
            CERRAR SESIÓN ➔
          </button>
        </form>
      </footer>
    </main>
  </div>
</Layout>
