---
interface Props {
  id?: string
  title?: string
  message?: string
}

const {
  id = 'neobrutal-popup',
  title = 'INFORMACIÓN',
  message = 'Este es un mensaje rápido de notificación.',
} = Astro.props
---

<!-- Pop-Up Container -->
<div
  id={id}
  class="fixed z-50 hidden w-64 border-4 border-black bg-white p-4 font-mono shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] transition-all duration-150"
  style="top: 0px; left: 0px;"
  role="dialog"
  aria-hidden="true"
>
  <!-- Triángulo del bocadillo (Puntero apuntando hacia arriba) -->
  <div
    class="absolute -top-3 left-6 h-0 w-0 border-x-8 border-b-12 border-x-transparent border-b-black"
  >
  </div>
  <div
    class="absolute -top-2 left-6 h-0 w-0 border-x-8 border-b-12 border-x-transparent border-b-yellow-300"
  >
  </div>

  <!-- Header del Pop-Up -->
  <div
    class="mb-2 flex items-center justify-between border-b-2 border-black pb-2"
  >
    <div class="flex items-center gap-1.5">
      <span class="inline-block h-3 w-3 border border-black bg-yellow-300"
      ></span>
      <h4 class="text-sm font-black tracking-tight text-black uppercase">
        {title}
      </h4>
    </div>
    <button
      data-close-popup
      type="button"
      class="flex h-6 w-6 cursor-pointer items-center justify-center border-2 border-black bg-red-400 text-xs font-black text-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:bg-red-500 active:translate-x-0.5 active:translate-y-0.5 active:shadow-none"
      aria-label="Cerrar"
    >
      ✕
    </button>
  </div>

  <!-- Contenido -->
  <div class="text-xs leading-relaxed font-bold text-black">
    <slot>
      <p>{message}</p>
    </slot>
  </div>
</div>

<script>
  declare global {
    interface Window {
      showNeobrutalPopUp: (event: MouseEvent, targetId?: string) => void
    }
  }

  window.showNeobrutalPopUp = (
    event: MouseEvent,
    targetId = 'neobrutal-popup'
  ) => {
    const popup = document.getElementById(targetId)
    if (!popup) return

    // Obtener la posición del clic
    const x = event.clientX
    const y = event.clientY

    const popupWidth = 256
    const padding = 16

    let leftPos = x - 28 
    if (leftPos + popupWidth > window.innerWidth - padding) {
      leftPos = window.innerWidth - popupWidth - padding
    }
    if (leftPos < padding) leftPos = padding

    popup.style.top = `${y + 12}px`
    popup.style.left = `${leftPos}px`

    popup.classList.remove('hidden')
    popup.setAttribute('aria-hidden', 'false')
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement

    if (target.closest('[data-close-popup]')) {
      const popup = target.closest('[role="dialog"]')
      popup?.classList.add('hidden')
      popup?.setAttribute('aria-hidden', 'true')
      return
    }

    const activePopups = document.querySelectorAll(
      '[role="dialog"]:not(.hidden)'
    )
    activePopups.forEach((popup) => {
      if (!popup.contains(target) && !target.closest('[data-popup-trigger]')) {
        popup.classList.add('hidden')
        popup.setAttribute('aria-hidden', 'true')
      }
    })
  })
</script>
