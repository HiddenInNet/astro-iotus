---
import { name } from '@/data/info.json'

const currentYear = new Date().getFullYear()

const links = [
  { name: 'Inicio', href: '/' },
  { name: 'Proyectos', href: '/proyectos' },
  { name: 'Noticias', href: '/noticias' },
  { name: 'Sobre Nosotros', href: '/sobre-nosotros' },
]

const socialLinks = [
  { name: 'GitHub', href: 'https://github.com' },
  { name: 'Twitter / X', href: 'https://twitter.com' },
  { name: 'Discord', href: 'https://discord.com' },
]
---

<footer
  class="w-full border-t-4 border-black bg-yellow-300 font-mono text-black"
>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-12">
      <!-- Columna 1: Branding / Identity -->
      <div class="space-y-4 md:col-span-5">
        <div
          class="inline-block border-4 border-black bg-white px-3 py-1 text-2xl font-black uppercase shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
        >
          {name || 'IOTUS'}
        </div>
        <p
          class="max-w-sm text-xs leading-relaxed font-bold text-slate-900 uppercase"
        >
          Portal tecnológico neobrutalista de alto rendimiento. Control de
          acceso, gestión de inventario y comunidad.
        </p>
        <div class="flex items-center gap-2 text-xs font-black uppercase">
          <span class="inline-block h-3 w-3 border-2 border-black bg-lime-400"
          ></span>
          <span>SISTEMA OPERATIVO Y EN LÍNEA</span>
        </div>
      </div>

      <!-- Columna 2: Navegación Principal -->
      <div class="space-y-3 md:col-span-4">
        <h3
          class="inline-block border-b-2 border-black pb-1 text-sm font-black uppercase"
        >
          Navegación
        </h3>
        <ul class="space-y-2 text-xs font-bold uppercase">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-block border-2 border-transparent px-1 py-0.5 transition-all hover:border-black hover:bg-pink-400 hover:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]"
                >
                  ➔ {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Columna 3: Redes / Enlaces Externos -->
      <div class="space-y-3 md:col-span-3">
        <h3
          class="inline-block border-b-2 border-black pb-1 text-sm font-black uppercase"
        >
          Comunidad
        </h3>
        <ul class="space-y-2 text-xs font-bold uppercase">
          {
            socialLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block border-2 border-black bg-white px-2 py-1 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all hover:bg-cyan-400 active:translate-x-0.5 active:translate-y-0.5 active:shadow-none"
                >
                  {item.name} ↗
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Barra Inferior de Copyright / Estado -->
    <div
      class="mt-12 flex flex-col items-center justify-between gap-4 border-t-4 border-black pt-6 text-xs font-black uppercase sm:flex-row"
    >
      <div>
        © {currentYear}
        {name || 'IOTUS'}. TODOS LOS DERECHOS RESERVADOS.
      </div>
      <!-- <div class="flex items-center gap-4">
        <a href="/privacidad" class="underline hover:bg-white hover:px-1"
          >Privacidad</a
        >
        <span>|</span>
        <a href="/terminos" class="underline hover:bg-white hover:px-1"
          >Términos</a
        >
      </div> -->
    </div>
  </div>
</footer>
